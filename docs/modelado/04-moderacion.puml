@startuml 04-moderacion
!include estilo.puml
title Paquete Moderación · casos de uso
left to right direction

actor "Moderador/a" as M

rectangle "HeartEats · Moderación" {
  usecase "CU-18\nConsultar la cola de solicitudes" as CU18
  usecase "CU-19\nRevisar una solicitud" as CU19
  usecase "CU-20\nRevisar la propuesta\nde un local" as CU20
  usecase "CU-21\nRevisar una corrección" as CU21
  usecase "CU-22\nRevisar el equipo\nde un negocio" as CU22
  usecase "CU-23\nRevisar una petición\nde retirada" as CU23
  usecase "CU-24\nAprobar y publicar" as CU24
  usecase "CU-25\nRechazar con motivo" as CU25
  usecase "CU-26\nPedir más información" as CU26
  usecase "CU-27\nRegistrar la acción\nen la auditoría" as CU27
  usecase "CU-33\nAutenticarse\n(enlace mágico)" as CU33 <<pendiente>>
  usecase "CU-34\nRevisar fichas sin\nactualizar (más de 12 meses)" as CU34 <<pendiente>>
}

M --> CU18
M --> CU19
M --> CU33
M --> CU34

CU20 --|> CU19
CU21 --|> CU19
CU22 --|> CU19
CU23 --|> CU19

CU24 ..> CU19 : <<extend>>
CU25 ..> CU19 : <<extend>>
CU26 ..> CU19 : <<extend>>
CU24 ..> CU27 : <<include>>
CU25 ..> CU27 : <<include>>
CU26 ..> CU27 : <<include>>
CU18 ..> CU33 : <<include>>
CU34 ..> CU33 : <<include>>

note bottom of CU24
  Se aprueba solo con todas las
  comprobaciones de la solicitud hechas.
  En un local nuevo, también con nivel
  de insignia y método elegidos.
end note

note right of CU33
  Pendiente (gris): decisión P5.
  Hoy se entra desde el menú.
end note
@enduml
