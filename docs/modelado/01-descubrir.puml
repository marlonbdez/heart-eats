@startuml 01-descubrir
!include estilo.puml
title Paquete Descubrir · casos de uso
left to right direction

actor "Visitante" as V
actor "Servicio de mapas" as MAP <<sistema externo>>
actor "Geolocalización\ndel dispositivo" as GEO <<sistema externo>>

rectangle "HeartEats · Descubrir" {
  usecase "CU-01\nExplorar el mapa" as CU01
  usecase "CU-02\nVer la lista de locales" as CU02
  usecase "CU-03\nBuscar sitios" as CU03
  usecase "CU-04\nFiltrar por tipo de comida" as CU04
  usecase "CU-05\nOrdenar por cercanía" as CU05
  usecase "CU-06\nConsultar la ficha de un local" as CU06
  usecase "CU-07\nLlegar al local o contactarlo" as CU07
  usecase "CU-08\nConsultar el equipo del local" as CU08
  usecase "CU-09\nConsultar la verificación del local" as CU09
}

V --> CU01
V --> CU02
V --> CU06
V --> CU03
V --> CU04
V --> CU05
V --> CU07

CU03 ..> CU01 : <<extend>>
CU03 ..> CU02 : <<extend>>
CU04 ..> CU01 : <<extend>>
CU04 ..> CU02 : <<extend>>
CU05 ..> CU01 : <<extend>>
CU05 ..> CU02 : <<extend>>
CU07 ..> CU06 : <<extend>>
CU08 ..> CU06 : <<extend>>\n[el negocio lo ha confirmado]
CU06 ..> CU09 : <<include>>

CU01 -- MAP
CU07 -- MAP
CU05 -- GEO

note bottom of CU01
  Si el mapa no se puede mostrar,
  se ofrece la lista (CU-02).
end note
@enduml
