@startuml 06-actividad-ciclo
!include estilo.puml
title Ciclo de una propuesta: proponer, verificar y publicar

|Colaborador/a|
start
:Propone un local\n(CU-10);

|Sistema|
:Valida y envía\n(CU-14);
if (¿Campo trampa\nrelleno?) then (sí)
  :Descarta\nen silencio;
  stop
else (no)
  :Deja la solicitud\nen la cola, con\nsus avisos;
endif

|Moderador/a|
:Revisa (CU-20) y\ncontacta con el negocio\n(fuera de la web);

|Negocio|
:Confirma que\nquiere aparecer;

|Moderador/a|
switch (¿Qué decide?)
case (rechazar)
  :Rechaza con\nmotivo (CU-25);
case (pedir información)
  :Pide más\ninformación (CU-26);
case (aprobar)
  :Aprueba con nivel\ny método (CU-24);
endswitch

|Sistema|
:Registra en la\nauditoría (CU-27);
if (¿Aprobada?) then (sí)
  :Publica la ficha;
  |Negocio|
  :Si quiere, cuenta\nsu equipo (CU-15);
endif
stop
@enduml
