' Estilo común de los diagramas de HeartEats: sobrio, fondo blanco (se lee
' igual en tema claro y oscuro) y texto oscuro sobre crema (contraste AA).
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam defaultFontColor #1F1F1F
skinparam shadowing false
skinparam roundCorner 14
skinparam nodesep 30
skinparam ranksep 40
skinparam ArrowColor #5A4A42
skinparam ArrowFontColor #3B2F2A
skinparam ArrowFontSize 11
skinparam NoteBackgroundColor #FFFDF7
skinparam NoteBorderColor #8A7B72
skinparam NoteFontColor #1F1F1F
skinparam TitleFontSize 16
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #5A4A42
  FontColor #1F1F1F
}
skinparam usecase {
  BackgroundColor #FFF4E6
  BorderColor #B5472B
  FontColor #1F1F1F
  BackgroundColor<<pendiente>> #F2F2F2
  BorderColor<<pendiente>> #6B6B6B
  FontColor<<pendiente>> #1F1F1F
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #B5472B
  FontColor #1F1F1F
}
skinparam package {
  BackgroundColor #FFF4E6
  BorderColor #B5472B
  FontColor #1F1F1F
}
skinparam activity {
  BackgroundColor #FFF4E6
  BorderColor #B5472B
  FontColor #1F1F1F
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #B5472B
  StartColor #5A4A42
  EndColor #5A4A42
  BarColor #5A4A42
}
skinparam swimlane {
  BorderColor #8A7B72
  TitleFontColor #1F1F1F
}
skinparam state {
  BackgroundColor #FFF4E6
  BorderColor #B5472B
  FontColor #1F1F1F
  StartColor #5A4A42
  EndColor #5A4A42
}
skinparam class {
  BackgroundColor #FFF4E6
  BorderColor #B5472B
  FontColor #1F1F1F
  AttributeFontColor #1F1F1F
  BackgroundColor<<servidor>> #F2F2F2
  BorderColor<<servidor>> #6B6B6B
}
