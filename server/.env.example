# Copia este archivo a .env para desarrollo local (.env no se sube al repo).
# En producción las variables se configuran en el panel del hosting.

NODE_ENV=development
PORT=3001
# Orígenes de la web que pueden llamar a la API, separados por comas.
CORS_ORIGINS=http://localhost:3000
# Conexión a MongoDB. En local: un Mongo propio o un clúster de Atlas de pruebas.
# En producción es obligatoria (Atlas, región UE).
MONGODB_URI=mongodb://127.0.0.1:27017/hearteats
# Saltos de proxy delante del servidor. En local 0; en Railway 1.
TRUST_PROXY=0
# Tope de envíos de la comunidad por IP (0 = sin límite). En producción,
# quita estas dos líneas para usar los valores por defecto (30/hora, 200/día).
SUBMISSIONS_PER_HOUR=0
SUBMISSIONS_PER_DAY=0
# Fotos: bucket privado de Cloudflare R2 (docs/14_PRODUCCION.md §3.3). Sin las
# cuatro, el servidor arranca y la subida responde 503. Añade R2_JURISDICTION=eu
# si el bucket se creó con jurisdicción UE.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PHOTOS_BUCKET=
# Origen público de la API: con él se componen las direcciones de las fotos.
# En producción es obligatorio si hay R2_* (https://api.hearteats.org).
# API_URL=http://localhost:3001
# Dirección de la web: los enlaces de acceso de moderación apuntan aquí.
WEB_URL=http://localhost:3000
# Correo del primer administrador (se da de alta al arrancar). Pon el tuyo aquí;
# en producción va en el panel del hosting, nunca en el repo.
ADMIN_EMAIL=
# Sin clave de Resend, el enlace de acceso se escribe en la consola del servidor.
# En producción es obligatoria.
RESEND_API_KEY=
# Remitente y dirección de respuesta de los correos. Los valores por defecto
# sirven; el dominio del remitente tiene que estar verificado en Resend.
# MAIL_FROM=HeartEats <acceso@mail.hearteats.org>
# MAIL_REPLY_TO=contact@hearteats.org
# Geocodificación de locales propuestos (ADR 0006). Sin claves. Los valores por
# defecto sirven; cambia el User-Agent solo si el contacto cambia.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=HeartEats (+https://hearteats.org; contact@hearteats.org)
# Secreto (mín. 32 caracteres) que firma los enlaces de «Info pedida». Genera uno
# con: openssl rand -hex 32. Vacío en local: cada arranque usa uno al azar.
# En producción es obligatorio.
REPLY_TOKEN_SECRET=
# Grandes cadenas que no encajan (nombres separados por comas). Una propuesta
# que las contenga recibe el aviso «chain». Vacío por defecto.
KNOWN_CHAINS=
